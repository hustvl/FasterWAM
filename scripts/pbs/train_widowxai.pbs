#!/usr/bin/env bash
#PBS -N fasterwam-widowxai
#PBS -q rt_HF
#PBS -P gcg51472
#PBS -l select=1
#PBS -l walltime=10:00:00
#PBS -j oe

set -euo pipefail

PBS_START_EPOCH=$(date +%s)
PBS_STARTED_AT=$(date -Is)
STAGE_SECONDS=0
PREFLIGHT_SECONDS=0
TRAIN_COMMAND_START_EPOCH=0
TRAIN_COMMAND_SECONDS=0
TIMING_OUTPUT_PATH=""

record_pbs_timing() {
  local status=$?
  set +e
  local end_epoch
  local total_seconds
  end_epoch=$(date +%s)
  total_seconds=$((end_epoch - PBS_START_EPOCH))
  if ((TRAIN_COMMAND_START_EPOCH > 0 && TRAIN_COMMAND_SECONDS == 0)); then
    TRAIN_COMMAND_SECONDS=$((end_epoch - TRAIN_COMMAND_START_EPOCH))
  fi
  echo "[timing] exit_status=${status} pbs_total_seconds=${total_seconds} stage_seconds=${STAGE_SECONDS} preflight_seconds=${PREFLIGHT_SECONDS} train_command_seconds=${TRAIN_COMMAND_SECONDS} end=$(date -Is)"
  if [[ -n "${TIMING_OUTPUT_PATH}" ]]; then
    printf '{\n  "pbs_job_id": "%s",\n  "run_id": "%s",\n  "exit_status": %d,\n  "started_at": "%s",\n  "pbs_total_seconds": %d,\n  "stage_seconds": %d,\n  "preflight_seconds": %d,\n  "train_command_seconds": %d,\n  "recorded_at": "%s"\n}\n' \
      "${PBS_JOBID}" "${RUN_ID}" "${status}" "${PBS_STARTED_AT}" "${total_seconds}" "${STAGE_SECONDS}" \
      "${PREFLIGHT_SECONDS}" "${TRAIN_COMMAND_SECONDS}" "$(date -Is)" \
      > "${TIMING_OUTPUT_PATH}"
  fi
  trap - EXIT
  exit "${status}"
}
trap record_pbs_timing EXIT
trap 'echo "[timing] received SIGTERM at $(date -Is)" >&2; exit 143' TERM
trap 'echo "[timing] received SIGINT at $(date -Is)" >&2; exit 130' INT

REPO_ROOT="/home/acf16376hu/gitrepo/FasterWAM"
FASTWAM_REPO="/home/acf16376hu/gitrepo/FastWAM"
ENV_ROOT="/groups/gcg51472/acf16376hu/fastwam"
DATA_ROOT="/groups/gcg51472/acf16376hu/fasterwam"
MODEL_SOURCE_ROOT="/groups/gcg51472/fastwam/checkpoints/diffsynth"
TRAIN_SOURCE="/home/acf16376hu/data/real_widowxai_success_only"
EVAL_SOURCE="/home/acf16376hu/data/real_widowxai_test"
TEXT_CACHE_SOURCE="${DATA_ROOT}/text_embeds_cache/widowxai"
ACTION_DIT_SOURCE="${DATA_ROOT}/checkpoints/SparseActionDiT_cond_0_4_8_12_16_20_24_28_Wan22_alphascale_1024hdim_widowxai.pt"
STATS_PATH="${DATA_ROOT}/dataset_stats.json"
READY_PATH="${DATA_ROOT}/widowxai_preparation.ready"
TASK_CONFIG="widowxai_fasterwam_3cam_384_1e-4"

test -s "${READY_PATH}"
test -s "${ACTION_DIT_SOURCE}"
test -s "${STATS_PATH}"
test -d "${TEXT_CACHE_SOURCE}"

export FASTWAM_DATA_ROOT="${DATA_ROOT}"
export FASTWAM_MODEL_ROOT="${MODEL_SOURCE_ROOT}"
export FASTERWAM_OUTPUT_ROOT="${DATA_ROOT}/runs"
export PIXI_HOME="${ENV_ROOT}/pixi"
export TORCH_EXTENSIONS_DIR="${ENV_ROOT}/cache/torch_extensions"
export HF_HOME="${ENV_ROOT}/cache/huggingface"
export TMPDIR="${PBS_LOCALDIR:-${DATA_ROOT}/tmp/${PBS_JOBID}}"
export PYTHONUNBUFFERED=1
export PYTHONNOUSERSITE=1
export NCCL_DEBUG="${NCCL_DEBUG:-WARN}"
export WANDB_MODE="${WANDB_MODE:-online}"
export RUN_ID="${RUN_ID:-widowxai_equal_loss_$(date +%Y-%m-%d_%H-%M-%S)_${PBS_JOBID}}"
export OMP_NUM_THREADS="${OMP_NUM_THREADS:-16}"

mkdir -p "${TMPDIR}" "${DATA_ROOT}/pbs_logs" "${FASTERWAM_OUTPUT_ROOT}"
TIMING_OUTPUT_PATH="${DATA_ROOT}/pbs_logs/widowxai-train-${PBS_JOBID}.timing.json"
exec > >(tee -a "${DATA_ROOT}/pbs_logs/widowxai-train-${PBS_JOBID}.log") 2>&1
cd "${REPO_ROOT}"
ulimit -n 131072

run_in_env() {
  bash "${FASTWAM_REPO}/scripts/pixi_run.sh" \
    env "PYTHONPATH=${REPO_ROOT}/src" "$@"
}

echo "[train] start=$(date -Is) host=$(hostname) job=${PBS_JOBID} run_id=${RUN_ID}"
nvidia-smi --query-gpu=index,name,memory.total,driver_version --format=csv,noheader

TRAIN_DATASET="${TRAIN_SOURCE}"
EVAL_DATASET="${EVAL_SOURCE}"
TEXT_CACHE="${TEXT_CACHE_SOURCE}"
MODEL_ROOT="${MODEL_SOURCE_ROOT}"
ACTION_DIT_PATH="${ACTION_DIT_SOURCE}"

if [[ -n "${PBS_LOCALDIR:-}" && -d "${PBS_LOCALDIR}" ]]; then
  STAGE_START_EPOCH=$(date +%s)
  echo "[train] staging datasets, text cache, and model weights to ${PBS_LOCALDIR}"
  LOCAL_DATA_ROOT="${PBS_LOCALDIR}/fasterwam_data"
  LOCAL_MODEL_ROOT="${PBS_LOCALDIR}/fasterwam_models"
  LOCAL_WAN_ROOT="${LOCAL_MODEL_ROOT}/Wan-AI/Wan2.2-TI2V-5B"
  mkdir -p "${LOCAL_DATA_ROOT}" "${LOCAL_WAN_ROOT}"
  cp -a "${TRAIN_SOURCE}" "${LOCAL_DATA_ROOT}/train"
  cp -a "${EVAL_SOURCE}" "${LOCAL_DATA_ROOT}/eval"
  cp -a "${TEXT_CACHE_SOURCE}" "${LOCAL_DATA_ROOT}/text_cache"
  cp -a \
    "${MODEL_SOURCE_ROOT}/Wan-AI/Wan2.2-TI2V-5B/Wan2.2_VAE.pth" \
    "${MODEL_SOURCE_ROOT}/Wan-AI/Wan2.2-TI2V-5B"/diffusion_pytorch_model-*.safetensors \
    "${LOCAL_WAN_ROOT}/"
  cp -a "${ACTION_DIT_SOURCE}" "${LOCAL_MODEL_ROOT}/SparseActionDiT_widowxai.pt"
  TRAIN_DATASET="${LOCAL_DATA_ROOT}/train"
  EVAL_DATASET="${LOCAL_DATA_ROOT}/eval"
  TEXT_CACHE="${LOCAL_DATA_ROOT}/text_cache"
  MODEL_ROOT="${LOCAL_MODEL_ROOT}"
  ACTION_DIT_PATH="${LOCAL_MODEL_ROOT}/SparseActionDiT_widowxai.pt"
  STAGE_SECONDS=$(($(date +%s) - STAGE_START_EPOCH))
fi
echo "[timing] stage_seconds=${STAGE_SECONDS}"

export FASTWAM_MODEL_ROOT="${MODEL_ROOT}"
export DIFFSYNTH_MODEL_BASE_PATH="${MODEL_ROOT}"

echo "[train] train_data=${TRAIN_DATASET}"
echo "[train] eval_data=${EVAL_DATASET}"
echo "[train] text_cache=${TEXT_CACHE}"
echo "[train] model_root=${MODEL_ROOT}"
echo "[train] sparse_action_dit=${ACTION_DIT_PATH}"
echo "[train] batch_per_gpu=32 gradient_accumulation=4 world_size=8 global_batch=1024 max_steps=1600 passes=27.96 lambda_video=1.0 lambda_action=1.0"

PREFLIGHT_START_EPOCH=$(date +%s)
run_in_env python -u - \
  "${TRAIN_DATASET}" "${EVAL_DATASET}" "${TEXT_CACHE}" \
  "${ACTION_DIT_PATH}" "${STATS_PATH}" <<'PY'
import sys
from pathlib import Path

import deepspeed
import torch
from hydra import compose, initialize_config_dir

train_dir, eval_dir, text_cache, action_path, stats_path = sys.argv[1:]
assert torch.cuda.device_count() == 8, torch.cuda.device_count()
assert all("H200" in torch.cuda.get_device_name(i) for i in range(8))
assert deepspeed.__version__ == "0.19.4", deepspeed.__version__
for required in (train_dir, eval_dir, text_cache, action_path, stats_path):
    assert Path(required).exists(), required
with initialize_config_dir(config_dir=str(Path.cwd() / "configs"), version_base="1.3"):
    cfg = compose(
        config_name="train",
        overrides=["task=widowxai_fasterwam_3cam_384_1e-4"],
    )
assert cfg.batch_size == 32
assert cfg.gradient_accumulation_steps == 4
assert cfg.batch_size * torch.cuda.device_count() * cfg.gradient_accumulation_steps == 1024
assert cfg.max_steps == 1600
assert cfg.model.mot_checkpoint_mixed_attn is True
assert cfg.model.loss.lambda_video == 1.0
assert cfg.model.loss.lambda_action == 1.0
assert list(cfg.model.condition_layers) == [0, 4, 8, 12, 16, 20, 24, 28]
payload = torch.load(action_path, map_location="cpu", weights_only=True)
assert payload["meta"]["condition_layers"] == [0, 4, 8, 12, 16, 20, 24, 28]
print("preflight ok: FastWAM Pixi, 8xH200, sparse init/stats/data, equal losses")
PY
PREFLIGHT_SECONDS=$(($(date +%s) - PREFLIGHT_START_EPOCH))
echo "[timing] preflight_seconds=${PREFLIGHT_SECONDS}"

TRAIN_COMMAND_START_EPOCH=$(date +%s)
run_in_env bash scripts/train_zero2_offload.sh 8 \
  "task=${TASK_CONFIG}" \
  "data.train.dataset_dirs=[${TRAIN_DATASET}]" \
  "data.val.dataset_dirs=[${EVAL_DATASET}]" \
  "data.train.text_embedding_cache_dir=${TEXT_CACHE}" \
  "data.val.text_embedding_cache_dir=${TEXT_CACHE}" \
  "data.train.pretrained_norm_stats=${STATS_PATH}" \
  "model.action_dit_pretrained_path=${ACTION_DIT_PATH}" \
  "model.redirect_common_files=false" \
  "model.loss.lambda_video=1.0" \
  "model.loss.lambda_action=1.0" \
  "num_epochs=28" \
  "max_steps=1600" \
  "wandb.enabled=true" \
  "wandb.name=${RUN_ID}" \
  "wandb.group=widowxai_equal_loss"
TRAIN_COMMAND_SECONDS=$(($(date +%s) - TRAIN_COMMAND_START_EPOCH))
echo "[timing] train_command_seconds=${TRAIN_COMMAND_SECONDS}"
